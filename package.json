{
  "name": "chainguard-lite",
  "version": "1.0.0",
  "description": "Testnet-only AI-assisted crypto safety screening service with The Graph and Hedera x402 payments",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "vercel-build": "vite build web --config web/vite.config.ts",
    "check:providers": "tsx scripts/check-providers.ts",
    "test:paid-request": "tsx scripts/test-paid-request.ts",
    "dev:report-service": "tsx watch src/report-service/server.ts",
    "dev:agent": "tsx watch src/agent/server.ts",
    "dev:web": "vite web --config web/vite.config.ts",
    "dev": "concurrently --names \"report,agent,web\" --prefix-colors \"cyan,yellow,magenta\" \"npm run dev:report-service\" \"npm run dev:agent\" \"npm run dev:web\"",
    "test": "vitest run"
  },
  "keywords": [
    "hedera",
    "x402",
    "the-graph",
    "ethonline2026",
    "crypto-safety"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hashgraph/sdk": "^2.68.0",
    "@x402/core": "^2.25.0",
    "@x402/express": "^2.25.0",
    "@x402/hedera": "^2.25.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "graphql": "^16.10.0",
    "graphql-request": "^7.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vitest": "^3.0.6"
  }
}
